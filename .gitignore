# macOS resource forks and metadata
._*
.DS_Store

# cloudflared is downloaded + checksum-verified at build time by
# tools/fetch-cloudflared.sh (wired into the QuipMac build), not committed.
# See issue #16 (removed the 37 MB binary from git).
QuipMac/Resources/cloudflared

QuipLinux/target/
QuipAndroid/.gradle/
QuipAndroid/app/build/
QuipAndroid/build/
QuipAndroid/local.properties
TODO.md
.superpowers/
docs/specs/

# Claude local — settings, memory dumps, transcripts. The user's
# auto-memory lives at ~/.claude/projects/... outside the repo, but
# any .claude/ contents that ever land INSIDE the repo are local-only
# scratch and must never ship.
.claude/

# Machine-local scripts and build configs (carry signing / device IDs)
*.local.sh
*.local.md
*.local.xcconfig

# APNs auth keys — PASSWORD-EQUIVALENT SECRETS. Anyone with these can
# push to every app on the developer account. Never commit, never upload.
# The Mac app reads them via the Keychain (see APNsKeyStore), not from disk.
*.p8
AuthKey_*.p8
**/AuthKey_*
apns-key*
APNs-Key*

# Environment files — assume any .env contains secrets.
.env
.env.*
!.env.example
!.env.sample

# Apple code-signing assets — certificates, private keys, provisioning
# profiles. Treat as PASSWORD-EQUIVALENT.
*.p12
*.pem
*.key
*.cer
*.cert
*.certSigningRequest
*.mobileprovision
*.provisionprofile
ExportOptions.plist

# Android signing — keystore holds the release-signing private key,
# keystore.properties holds the password to unlock it.
*.keystore
*.jks
keystore.properties

# Firebase / Google service configs — contain API keys and project IDs.
GoogleService-Info.plist
google-services.json
firebase-adminsdk-*.json
serviceAccountKey*.json

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/
build-ios/
build-mac/

# xcodegen-generated Info.plist — regenerated from <project>/project.yml, see README
QuipMac/Info.plist
QuipiOS/Info.plist

# Swift Package Manager
.build/
.swiftpm/

# Xcode build/test output bundles — result bundles from `-resultBundlePath`,
# archives from Product > Archive, exported apps and debug symbols.
*.xcresult
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# Coverage / profiling artifacts
*.profraw
*.profdata

# Editor droppings — vim swaps, backups, patch/merge leftovers, IDE state
*.swp
*.swo
*~
*.orig
*.rej
.idea/
.vscode/

# Local MCP server config — may carry tokens/credentials
.mcp.json

# JS tooling (docs/scripts) — never commit dependency trees
node_modules/

# Runtime logs — Mac/iOS Quip writes to ~/Library/Logs/Quip/ which is
# already outside the repo, but cover any log files that ever land
# inside the working tree (e.g. local diagnostic dumps).
*.log
logs/

# Machine-local / planning scripts — not for the public repo.
# ANCHORED with a leading slash: an unanchored `scripts/` matches a directory
# at ANY depth, which silently swallowed .github/scripts/ — so the CI workflow
# shipped referencing changed-scopes.sh and changed-scopes-test.sh while
# neither file was ever committed, and every run failed at the first step.
# `git status` said clean the whole time, because ignored files never show up.
/scripts/
/tasks/

# swrm board-integration runtime/event dir — local state, not for the repo
.swrm/

# Ralph autonomous-loop scratch — the PRD it's executing (prd.json) and its
# running progress log (progress.txt) are local runtime state, regenerated
# per task. Not product code; keep them out of commits (same class as .swrm/).
/prd.json
/progress.txt

# Tool droppings (claude-flow / ruflo scratch state)
.claude-flow/
