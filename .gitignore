# macOS resource forks and metadata
._*
.DS_Store

QuipLinux/target/
QuipAndroid/.gradle/
QuipAndroid/app/build/
QuipAndroid/build/
QuipAndroid/local.properties
TODO.md
.superpowers/
docs/specs/

# Claude local — settings, memory dumps, transcripts. The user's
# auto-memory lives at ~/.claude/projects/... outside the repo, but
# any .claude/ contents that ever land INSIDE the repo are local-only
# scratch and must never ship.
.claude/

# Machine-local scripts and build configs (carry signing / device IDs)
*.local.sh
*.local.md
*.local.xcconfig

# APNs auth keys — PASSWORD-EQUIVALENT SECRETS. Anyone with these can
# push to every app on the developer account. Never commit, never upload.
# The Mac app reads them via the Keychain (see APNsKeyStore), not from disk.
*.p8
AuthKey_*.p8
**/AuthKey_*
apns-key*
APNs-Key*

# Environment files — assume any .env contains secrets.
.env
.env.*
!.env.example
!.env.sample

# Apple code-signing assets — certificates, private keys, provisioning
# profiles. Treat as PASSWORD-EQUIVALENT.
*.p12
*.pem
*.key
*.cer
*.cert
*.certSigningRequest
*.mobileprovision
*.provisionprofile
ExportOptions.plist

# Android signing — keystore holds the release-signing private key,
# keystore.properties holds the password to unlock it.
*.keystore
*.jks
keystore.properties

# Firebase / Google service configs — contain API keys and project IDs.
GoogleService-Info.plist
google-services.json
firebase-adminsdk-*.json
serviceAccountKey*.json

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/
build-ios/
build-mac/

# xcodegen-generated Info.plist — regenerated from <project>/project.yml, see README
QuipMac/Info.plist
QuipiOS/Info.plist

# Swift Package Manager
.build/
.swiftpm/

# Coverage / profiling artifacts
*.profraw
*.profdata

# Runtime logs — Mac/iOS Quip writes to ~/Library/Logs/Quip/ which is
# already outside the repo, but cover any log files that ever land
# inside the working tree (e.g. local diagnostic dumps).
*.log
logs/

# Machine-local / planning scripts — not for the public repo
scripts/
tasks/

# swrm board-integration runtime/event dir — local state, not for the repo
.swrm/

# Ralph autonomous-loop scratch — the PRD it's executing (prd.json) and its
# running progress log (progress.txt) are local runtime state, regenerated
# per task. Not product code; keep them out of commits (same class as .swrm/).
/prd.json
/progress.txt
